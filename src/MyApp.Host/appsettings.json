{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Oracle": {
    "ConnectionString": "User Id=myapp;Password=CHANGE_ME;Data Source=localhost:1521/ORCLPDB1"
  },
  "InboundEvents": [
    {
      "Code": "OrderCreated",
      "SourceQueue": "orders.created.v1",
      "ConsumerGroup": "myapp-order-created",
      "Handler": "MyApp.Handlers.OrderCreatedHandler, MyApp.Handlers"
    }
  ],
  "OutboundEvents": [
    {
      "Code": "InvoiceReady",
      "SourceView": "V_PENDING_INVOICES",
      "SuccessProcedure": "PKG_INVOICE.MARK_SENT",
      "ErrorProcedure": "PKG_INVOICE.MARK_FAILED",
      "TargetTopic": "invoices.ready.v1",
      "PollingIntervalSeconds": 15,
      "Source": "MyApp.OutboundSources.InvoiceReadySource, MyApp.OutboundSources"
    }
  ]
}
